# Banco (obrigatório para o app). Login que herda app_user, nunca o dono das tabelas.
DATABASE_URL=postgres://advfin_web:SENHA@HOST:5432/postgres

# Modelo de linguagem. Sem chave, a pesquisa roda no modo extrativo (trechos literais, sem redação).
LLM_PROVEDOR=anthropic
LLM_CHAVE=
# Opcional: modelos por tarefa (padrão: claude-sonnet-5-5 na pesquisa, claude-haiku-5-5 na classificação)
# LLM_MODELO_PESQUISA=
# LLM_MODELO_CLASSIFICACAO=
# Opcional: R$ por milhão de tokens, para registrar o custo de cada consulta
# LLM_PRECO_ENTRADA=
# LLM_PRECO_SAIDA=
# Só para LLM_PROVEDOR=openai (qualquer API compatível: OpenAI, Azure, Maritaca…)
# LLM_URL_BASE=https://api.openai.com/v1

# Beta sem curador: mostra também dispositivos não conferidos, sempre marcados na tela.
# Em produção aberta, deixe desligado: só o que o curador publicou chega ao advogado.
BASE_INCLUIR_NAO_REVISADOS=1

# Laboratório do chat (/app/dev) e plataforma (/admin): pelo papel na tabela equipe_plataforma
# (admin, curador, suporte), não mais por DEV_EMAILS. O primeiro admin entra por SQL (docs/DEPLOY.md).

# Endereço público do app, para os links dos e-mails (convite, troca de e-mail).
APP_URL=http://localhost:3000

# Verificação em duas etapas: chave de 32 bytes em base64 que cifra os segredos TOTP.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obrigatória em produção; trocar a chave invalida o 2FA de todos.
CHAVE_CIFRA=

# E-mail transacional. Sem provedor, nada é enviado e a tela mostra o link do convite para copiar.
# EMAIL_PROVEDOR=resend
# EMAIL_CHAVE=
# EMAIL_REMETENTE=AdvFin <nao-responda@advfin.com.br>

# Cobrança por pessoa no Stripe. Sem STRIPE_CHAVE, não há limite de assentos (beta).
# STRIPE_CHAVE=sk_test_...
# STRIPE_WEBHOOK_SEGREDO=whsec_...   (endpoint: /api/stripe/webhook)
# STRIPE_PRECO_ESSENCIAL=price_...
# STRIPE_PRECO_ESCRITORIO=price_...
# STRIPE_PRECO_TRIBUTARIO_PRO=price_...
